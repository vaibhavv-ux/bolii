# Copy this file to .env and fill in your real values. Never commit .env.

# Dodo Payments
DODO_PAYMENTS_API_KEY=your_dodo_api_key_here
DODO_PRODUCT_ID=pdt_your_product_id_here
DODO_WEBHOOK_SECRET=whsec_your_webhook_secret_here
DODO_ENV=live_mode

# Your deployed site URL (used as payment return URL)
SITE_URL=https://your-site.netlify.app

# Database Connection (Neon / Supabase / Postgres)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Server Port (local dev only)
PORT=3001
